# Copy this file to .env and fill in what you need.
# Never commit your real keys to source control.

# --- Django ---
DJANGO_SECRET_KEY=replace-this-with-a-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1 localhost

# --- AI providers ---------------------------------------------------------
# The app works with ZERO keys: the built-in "mock" provider is always on.
# Add any key below to enable a real provider; the UI picks them up automatically.

# Default provider shown on load: mock | openai | gemini | ollama
AI_DEFAULT_PROVIDER=mock

# Optionally restrict which non-mock providers appear (comma-separated).
# Leave empty to expose all known providers.
# AI_ENABLED_PROVIDERS=openai,gemini,ollama

# OpenAI (paid). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # only for proxies / Azure-style gateways

# Google Gemini (has a free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama (local, free, no key). Install from https://ollama.com then:
#   ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# System prompt + how many prior turns to remember per session.
# AI_SYSTEM_PROMPT=You are a concise and helpful assistant inside the SceneMind app.
# AI_HISTORY_TURNS=6
